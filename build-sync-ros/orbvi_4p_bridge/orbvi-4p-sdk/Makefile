	cd /home/k8plus/src/orbvi-4p/orbvi_4p_bridge/build-sync-ros/orbvi_4p_bridge && $(MAKE) $(MAKESILENT) -f orbvi-4p-sdk/CMakeFiles/orbvi_sdk_shared.dir/build.make orbvi-4p-sdk/CMakeFiles/orbvi_sdk_shared.dir/src/status.cpp.s
.PHONY : src/status.cpp.s

